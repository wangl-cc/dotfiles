#==============================================================================#
# box-base
#==============================================================================#

FROM registry.fedoraproject.org/fedora:latest AS box-base

ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=1000

COPY rootfs/base /

RUN sed -i 's/enabled=1/enabled=0/' /etc/yum.repos.d/fedora-cisco-openh264.repo

# Reinstall base packages with documentation included.
RUN --mount=type=cache,target=/var/cache/libdnf5 \
    dnf upgrade -y && \
    dnf reinstall -y --setopt=keepcache=1 \
    $(rpm -qa --queryformat '%{NAME}\n' | grep -v gpg-pubkey) && \
    rm -rf /var/log/dnf*

RUN --mount=type=cache,target=/var/cache/libdnf5 \
    dnf install -y --setopt=keepcache=1 \
    ca-certificates curl \
    fish git man-db openssh-clients tar unzip which \
    gcc gcc-c++ make cmake pkgconfig \
    procps-ng psmisc perf sudo && \
    rm -rf /var/log/dnf*

RUN groupadd -g "$USER_GID" "$USERNAME" && \
    useradd -m -u "$USER_UID" -g "$USER_GID" -s /usr/bin/fish "$USERNAME" && \
    echo "$USERNAME ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/sudo-nopasswd && \
    chmod 0440 /etc/sudoers.d/sudo-nopasswd

RUN ln -s /home /var/home

#==============================================================================#
# dev-box
#==============================================================================#

FROM box-base AS dev-box

COPY rootfs/dev-box /

RUN --mount=type=cache,target=/var/cache/libdnf5 \
    dnf install -y --setopt=keepcache=1 openssh-server && \
    rm -rf /var/log/dnf*

USER root

CMD ["/usr/local/sbin/dev-box-run"]

#==============================================================================#
# codex-box
#==============================================================================#

FROM box-base AS codex-box

ARG CODEX_REPO
ARG CODEX_VERSION
ARG CODEX_ASSET
ARG CODEX_SHA256

# Install Prebuilt Codex from GitHub
RUN test -n "$CODEX_VERSION" && \
    test -n "$CODEX_REPO" && \
    test -n "$CODEX_ASSET" && \
    test -n "$CODEX_SHA256" && \
    install -d -m 0755 /opt/codex && \
    install -d -m 0700 -o "$USERNAME" -g "$USERNAME" "/home/$USERNAME/.codex" && \
    curl -fsSL \
    "https://github.com/${CODEX_REPO}/releases/download/rust-v${CODEX_VERSION}/${CODEX_ASSET}" \
    -o /tmp/codex.tar.gz && \
    echo "$CODEX_SHA256  /tmp/codex.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/codex.tar.gz -C /opt/codex && \
    rm -f /tmp/codex.tar.gz && \
    ln -s /opt/codex/bin/codex /usr/local/bin/codex && \
    /usr/local/bin/codex --version

# Flatten Fedora's SSH defaults because the nested Codex sandbox cannot
# validate root-owned include files from the outer user namespace.
RUN sed -i '\|^Include /etc/ssh/ssh_config.d/\*\.conf$|d' /etc/ssh/ssh_config && \
    for config in /etc/ssh/ssh_config.d/*.conf; do \
        sed \
        -e '\|^[[:space:]]*Include /etc/crypto-policies/back-ends/openssh.config$|r /etc/crypto-policies/back-ends/openssh.config' \
        -e '\|^[[:space:]]*Include /etc/crypto-policies/back-ends/openssh.config$|d' \
        "$config"; \
    done >> /etc/ssh/ssh_config && \
    ! grep -Eq '^[[:space:]]*Include[[:space:]]' /etc/ssh/ssh_config

USER ${USERNAME}

WORKDIR /home/${USERNAME}

CMD ["/usr/local/bin/codex", "app-server", "--remote-control", "--listen", "unix://"]
