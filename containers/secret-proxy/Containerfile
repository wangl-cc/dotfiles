FROM docker.io/library/golang:1.27.1-alpine AS source
WORKDIR /src
COPY . .

FROM source AS test
RUN go test -count=1 ./...

FROM source AS build
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /secret-proxy ./cmd/secret-proxy

FROM scratch AS runtime
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /secret-proxy /secret-proxy

ENTRYPOINT ["/secret-proxy"]
