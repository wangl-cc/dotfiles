FROM docker.io/rocm/vllm@sha256:b8a082f346d069376d35784250e38b23a043efe979408ae3a33d7c6b62ee3276

# TODO: Move to an official vllm/vllm-openai-rocm release containing both fixes:
# - Dynamic RoPE with graph capture: https://github.com/vllm-project/vllm/pull/58064
# - ROCr idle polling: https://github.com/ROCm/rocm-systems/pull/7898

# Replace the verified ROCr library
RUN curl --fail --location --retry 3 \
      https://rocm.nightlies.amd.com/whl-multi-arch/rocm_sdk_core-10.1.0a20260822-py3-none-linux_x86_64.whl \
      --output /tmp/rocm-core.whl \
    && echo 'cf376d3465cffd0c755a1e1ec08324c519eaf3d79c56778ffede1f6a7a2a5729  /tmp/rocm-core.whl' | sha256sum --check \
    && unzip -p /tmp/rocm-core.whl _rocm_sdk_core/lib/libhsa-runtime64.so.1 \
      > /opt/python/lib/python3.14/site-packages/_rocm_sdk_core/lib/libhsa-runtime64.so.1 \
    && echo 'b3719c23d3636e9f125752c3e3505cc4de73d2566b5aedd731eaaec542f284dc  /opt/python/lib/python3.14/site-packages/_rocm_sdk_core/lib/libhsa-runtime64.so.1' | sha256sum --check \
    && rm /tmp/rocm-core.whl

ENTRYPOINT ["vllm", "serve"]
