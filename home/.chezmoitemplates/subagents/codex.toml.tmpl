{{- if not (has .access (list "read-only" "workspace-write")) -}}
{{- fail (printf "unsupported Codex access profile: %s" .access) -}}
{{- end -}}
name = {{ .name | toJson }}
{{- with (get .codex "model") }}
model = {{ . | toJson }}
{{- end }}
{{- with (get .codex "reasoning") }}
model_reasoning_effort = {{ . | toJson }}
{{- end }}
{{- if eq .access "read-only" }}
default_permissions = ":read-only"
{{- end }}

description = """
{{ .description }}

When to use: {{ .when_to_use }}
How to use: {{ .how_to_use }}
"""

developer_instructions = """
{{ .prompt }}{{- with (get .codex "additional_instructions") }}
{{ . }}
{{- end }}
"""
