mode = "symlink"

[env]
PATH = {{ concat (list (joinPath .chezmoi.homeDir ".local/bin") (joinPath .chezmoi.homeDir ".cargo/bin")) (splitList ":" (env "PATH")) | uniq | join ":" | quote }}

[data.mirrors]
{{- /* Use mirrors in China, we determine if in China by comparing tzdata */}}
enabled = {{ eq (include "/etc/localtime" | sha1sum)  "79360e38e040eaa15b6e880296c1d1531f537b6f" }}

[data.homebrew]
{{- /* Determine homebrew prefix based on OS and arch */}}
prefix = {{ if eq .chezmoi.os "darwin" -}}
  {{- if eq .chezmoi.arch "arm64" -}}
    "/opt/homebrew"
  {{- else -}}
    "/usr/local"
  {{- end -}}
{{- else -}}
  "/home/linuxbrew/.linuxbrew"
{{- end }}

[data.kache]
{{- $kacheMaxSizeGiB := promptIntOnce . "kache.maxSizeGiB" "Maximum local kache store size in GiB" 20 }}
{{- if lt $kacheMaxSizeGiB 1 }}
{{-   fail (printf "kache.maxSizeGiB must be greater than zero, got %d" $kacheMaxSizeGiB) }}
{{- end }}
maxSizeGiB = {{ $kacheMaxSizeGiB }}

[data.shell.fish]
auto = {{ promptBoolOnce . "shell.fish.auto" "Auto-enter fish from fallback bash/zsh sessions" true }}

[data.toolchains]
rustup = {{ promptChoiceOnce . "toolchains.rustup" "Rustup profile to install on this machine" (list "none" "minimal" "default" "complete") "none" | quote }}
node = {{ promptBoolOnce . "toolchains.node" "Install the configured Node.js major with pnpm on this machine" true }}

{{ if eq .chezmoi.os "darwin" -}}
[data.rime]
enabled = {{ promptBoolOnce . "rime.enabled" "Deploy Rime configuration and rime-ice on this Mac" true }}
{{ end }}
[data.git]
name = "Loong"
email = "git@loongw.cc"
{{- $gitSigningKeyFiles := glob (joinPath .chezmoi.homeDir ".ssh/*.pub") }}
{{- $gitSigningDisabled := "none" }}
{{- $gitSigningKeyChoices := list $gitSigningDisabled }}
{{- range $gitSigningKeyPath := $gitSigningKeyFiles }}
{{-   $gitSigningKeyChoices = append $gitSigningKeyChoices (trimSuffix ".pub" (base $gitSigningKeyPath)) }}
{{- end }}
{{- $gitSigningKeySelection := promptChoiceOnce . "git.signingkeyFile" "Git SSH commit signing public key" $gitSigningKeyChoices $gitSigningDisabled }}
{{- $gitSigningKeyFile := "" }}
{{- if or (eq $gitSigningKeySelection "") (eq $gitSigningKeySelection $gitSigningDisabled) }}
{{- else if contains "/" $gitSigningKeySelection }}
{{-   $gitSigningKeyFile = $gitSigningKeySelection }}
{{- else if hasSuffix ".pub" $gitSigningKeySelection }}
{{-   $gitSigningKeyFile = printf "~/.ssh/%s" $gitSigningKeySelection }}
{{- else }}
{{-   $gitSigningKeyFile = printf "~/.ssh/%s.pub" $gitSigningKeySelection }}
{{- end }}
signingkeyFile = {{ $gitSigningKeyFile | quote }}

{{ if eq .chezmoi.os "linux" -}}
{{- /* Legacy flags supply migration defaults only; consumers use the new groups. */ -}}
{{- $legacyWorkspace := get (get . "workspace" | default dict) "enabled" | default false -}}
{{- $legacySMB := get (get . "smb" | default dict) "enabled" | default false -}}
{{- $legacyTunnel := and $legacyWorkspace (get (get . "cloudflared" | default dict) "enabled" | default false) -}}
[data.services]
{{- $developmentEnabled := promptBoolOnce . "services.development" "Deploy development containers and their credential proxy" $legacyWorkspace }}
development = {{ $developmentEnabled }}
{{- $smbEnabled := promptBoolOnce . "services.smb" "Deploy SMB file sharing" $legacySMB }}
smb = {{ $smbEnabled }}

[data.ingress]
{{- $caddyEnabled := false }}
{{- $tunnelEnabled := false }}
{{- if $developmentEnabled }}
{{- $caddyEnabled = promptBoolOnce . "ingress.caddy" "Configure private HTTPS ingress through Caddy" $legacyWorkspace }}
{{- $tunnelEnabled = promptBoolOnce . "ingress.cloudflared" "Configure public ingress through Cloudflare Tunnel" $legacyTunnel }}
{{- end }}
caddy = {{ $caddyEnabled }}
cloudflared = {{ $tunnelEnabled }}

{{ if or $developmentEnabled $smbEnabled $caddyEnabled $tunnelEnabled -}}
[data.device]
{{- if or $developmentEnabled $smbEnabled $caddyEnabled }}
{{- $ip := promptStringOnce . "device.tailscale_ipv4" "Device Tailscale IPv4 address" "" | trim }}
{{- if and $ip (not (regexMatch `^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])(\.(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])){2}$` $ip)) }}
{{- fail "device.tailscale_ipv4 must be an IPv4 address in 100.64.0.0/10, or empty" }}
{{- end }}
tailscale_ipv4 = {{ $ip | quote }}
{{- end }}
{{- if or $caddyEnabled $tunnelEnabled }}
{{- $domain := promptStringOnce . "device.domain" "Device DNS suffix (e.g. workstation.example.com)" "" | trim | lower }}
{{- if and $domain (not (regexMatch `^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$` $domain)) }}
{{- fail "device.domain must be a DNS suffix such as workstation.example.com, or empty" }}
{{- end }}
{{- if not $domain }}
{{- fail "device.domain is required when ingress.caddy or ingress.cloudflared is true" }}
{{- end }}
domain = {{ $domain | quote }}
{{- end }}
{{- end }}

{{ if $caddyEnabled -}}
[data.acme]
ca = "https://acme.zerossl.com/v2/DV90"
{{- $email := promptStringOnce . "acme.email" "ACME contact email (required for Caddy with ZeroSSL)" "" | trim }}
{{- if and $email (not (regexMatch `^[^[:space:]@"{}]+@[^[:space:]@"{}]+\.[^[:space:]@"{}]+$` $email)) }}
{{- fail "acme.email must be an email address" }}
{{- end }}
{{- if not $email }}
{{- fail "acme.email is required for Caddy using ZeroSSL" }}
{{- end }}
email = {{ $email | quote }}
{{- end }}

{{ if $tunnelEnabled -}}
[data.cloudflared]
{{- $tunnelID := promptStringOnce . "cloudflared.tunnel_id" "Locally managed Cloudflare Tunnel UUID" "" | trim | lower }}
{{- if not (regexMatch `^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$` $tunnelID) }}
{{- fail "cloudflared.tunnel_id must be a Tunnel UUID" }}
{{- end }}
tunnel_id = {{ $tunnelID | quote }}
{{- $team := promptStringOnce . "cloudflared.access_team" "Cloudflare Access team name (prefix of .cloudflareaccess.com)" "" | trim | lower }}
{{- if or (gt (len $team) 63) (not (regexMatch `^[a-z0-9]([a-z0-9-]*[a-z0-9])?$` $team)) }}
{{- fail "cloudflared.access_team must be a nonempty Cloudflare Access team name" }}
{{- end }}
access_team = {{ $team | quote }}
{{- $aud := promptStringOnce . "cloudflared.access_aud" "Access application AUD covering enabled public browser hostnames" "" | trim }}
{{- if not (regexMatch `^[0-9a-fA-F]{64}$` $aud) }}
{{- fail "cloudflared.access_aud must be the 64-character hexadecimal Access application AUD" }}
{{- end }}
access_aud = {{ $aud | quote }}
{{- end }}
{{- end }}
