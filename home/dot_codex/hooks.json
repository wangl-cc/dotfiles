{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/rtk-pre-tool-use\" codex",
            "timeout": 5,
            "statusMessage": "Rewriting command through RTK"
          }
        ]
      }
    ]
  }
}
