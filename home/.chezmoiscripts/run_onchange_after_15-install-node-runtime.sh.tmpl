#!/usr/bin/env sh

set -eu

# {{- $installNode := true }}
# {{- if hasKey .toolchains "node" }}
# {{-   $installNode = index .toolchains "node" }}
# {{- end }}
# {{- if $installNode }}
pnpm_bin="$HOME/.local/bin/pnpm"
if [ ! -x "$pnpm_bin" ]; then
  echo "pnpm portable binary not found at $pnpm_bin" >&2
  exit 1
fi

export PNPM_HOME="$HOME/.pnpm"
mkdir -p "$PNPM_HOME/bin"
export PATH="$PNPM_HOME/bin:$PATH"

echo "Installing the latest Node.js LTS release with pnpm"
"$pnpm_bin" runtime set node lts -g
"$PNPM_HOME/bin/node" --version
# {{- end }}
