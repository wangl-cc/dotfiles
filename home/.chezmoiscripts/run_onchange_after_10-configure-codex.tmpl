#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "tomlkit==0.13.3",
# ]
# ///
"""Replace managed values while preserving unmentioned local configuration."""

import sys
from pathlib import Path

import tomlkit
from tomlkit.items import Table

CONFIG_PATH = Path.home() / ".codex" / "config.toml"
KACHE_CACHE_DIR = (
    Path.home() / "Library" / "Caches" / "kache"
    if sys.platform == "darwin"
    else Path.home() / ".cache" / "kache"
)
UV_CACHE_DIR = Path.home() / ".cache" / "uv"

Patch = dict[str, object | None]
TomlContainer = tomlkit.TOMLDocument | Table

# Nested mappings are authoritative snapshots; complete replacement prevents local config drift.
TOP_LEVEL_PATCH: Patch = {
    "model": "gpt-6-astra",
    "model_reasoning_effort": "high",
    "approval_policy": "on-request",
    "approvals_reviewer": "guardian_subagent",
    "features": {
        "js_repl": True,
        "memories": True,
        "context_management": {
            "experimental_mode": True,
        },
        "multi_agent_v2": {
            "enabled": True,
            "multi_agent_mode_hint_text": {{ include ".chezmoitemplates/agents/delegation.md" | toJson }},
        },
    },
    "sandbox_mode": "workspace-write",
    "sandbox_workspace_write": {
        "network_access": True,
        "writable_roots": [str(KACHE_CACHE_DIR), str(UV_CACHE_DIR)],
    },
}

DESKTOP_PATCH: Patch = {
    "followUpQueueMode": "queue",
    "reviewDelivery": "detached",
    "preventSleepWhileRunning": True,
    "git-commit-instructions": """\
Choose commit messages style in this order:

1. Follow repository-local commit message instructions when present, such as AGENTS.md, CLAUDE.md, CONTRIBUTING.md, or an explicit user instruction.
2. If the repository has no explicit instructions, inspect the recent commit history and match its established style.
3. If neither local instructions nor recent history establish a style, use Conventional Commits.

Keep the subject concise, imperative. Add a body when it clarifies non-obvious context.
""",
    "git-pr-instructions": """\
Write PR titles as final-quality commit titles, no `[codex]` or similar source markers.
""",
    "git-pull-request-merge-method": "squash",
}


def read_document() -> tomlkit.TOMLDocument:
    if not CONFIG_PATH.exists():
        return tomlkit.document()
    return tomlkit.parse(CONFIG_PATH.read_text(encoding="utf-8"))


def ensure_table(container: TomlContainer, key: str) -> Table:
    value = container.get(key)
    if value is None:
        value = tomlkit.table()
        container[key] = value
    if not isinstance(value, Table):
        raise SystemExit(f"{key} must be a TOML table")
    return value


def apply_patch(old: TomlContainer, patch: Patch) -> None:
    for key, value in patch.items():
        current = old.get(key)
        if value is None:
            old.pop(key, None)
        elif current != value:
            old.pop(key, None)
            old[key] = value


def main() -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)

    before = CONFIG_PATH.read_text(encoding="utf-8") if CONFIG_PATH.exists() else ""
    document = read_document()
    apply_patch(document, TOP_LEVEL_PATCH)
    apply_patch(ensure_table(document, "desktop"), DESKTOP_PATCH)

    after = tomlkit.dumps(document)
    if after != before:
        CONFIG_PATH.write_text(after, encoding="utf-8")


if __name__ == "__main__":
    main()
