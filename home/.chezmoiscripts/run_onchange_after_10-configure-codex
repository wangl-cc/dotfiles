#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "tomlkit==0.13.3",
# ]
# ///
"""Replace managed values while preserving unmentioned local configuration."""

from pathlib import Path

import tomlkit
from tomlkit.items import Table

CONFIG_PATH = Path.home() / ".codex" / "config.toml"

Patch = dict[str, object | None]
TomlContainer = tomlkit.TOMLDocument | Table

# Nested mappings are authoritative snapshots; complete replacement prevents local config drift.
TOP_LEVEL_PATCH: Patch = {
    "model": "gpt-5.6-sol",
    "model_reasoning_effort": "high",
    "approval_policy": "on-request",
    "approvals_reviewer": "guardian_subagent",
    "features": {
        "js_repl": True,
        "memories": True,
        "context_management": {
            "experimental_mode": True,
        },
        "multi_agent_v2": {
            "enabled": True,
            "multi_agent_mode_hint_text": """\
Use sub-agents selectively when a configured role matches a bounded task and delegation provides concrete marginal value beyond accumulated local context. Prefer continuing locally after substantive investigation, user corrections, or design decisions. Do not delegate routine inspection, deterministic validation, or small edits.

Before spawning, check whether an existing agent owns the same or a closely related scope and treat it as the continuing owner of that workstream within the current task tree. Reuse it for clarification, follow-up investigation, revisions, or focused assessment of responses to its findings, passing only the new objective, changed evidence, decisions, and open questions. Do not reuse it for a different objective, scope, baseline, or target, or when fresh isolation is an explicit source of value.

Spawn a new agent only for a genuinely new, context-fresh subtask or a deliberately independent review. Give it a compact, self-contained handoff: one bounded objective or question; fixed decisions it must not reopen; explicit non-goals; supplied evidence; stopping criteria; maximum output shape; and what the delegating agent retains, including useful parallel work. Choose the narrowest fitting role and pass only task-relevant context.

The delegating agent owns decomposition, coordination, scope changes, result integration, and verification within its scope, escalating decisions outside it to its caller. A delegated agent may spawn a child only when its handoff explicitly authorizes nested delegation.

Across the delegation chain, use at most one active independent reviewer per artifact revision or claim. Reuse that reviewer for clarification, additional evidence, or focused follow-up on changes made from its findings; this is not a review chain. Use a new reviewer only when the scope, baseline, or claim differs from the previous review, or when fresh independence provides explicit value. After fixes, the agent responsible for the artifact performs deterministic verification.

For discovery and review, separate novel findings, confirmations, and unknowns. On follow-up, answer the requested delta without restating the previous report unless clarity requires it. If there is no novel finding, say so directly.
""",
        },
    },
    "sandbox_mode": "workspace-write",
    "sandbox_workspace_write": {
        "network_access": True,
    },
}

DESKTOP_PATCH: Patch = {
    "followUpQueueMode": "queue",
    "reviewDelivery": "detached",
    "preventSleepWhileRunning": True,
    "git-commit-instructions": """\
Choose commit messages style in this order:

1. Follow repository-local commit message instructions when present, such as AGENTS.md, CLAUDE.md, CONTRIBUTING.md, or an explicit user instruction.
2. If the repository has no explicit instructions, inspect the recent commit history and match its established style.
3. If neither local instructions nor recent history establish a style, use Conventional Commits.

Keep the subject concise, imperative. Add a body when it clarifies non-obvious context.
""",
    "git-pr-instructions": """\
Write PR titles as final-quality commit titles, no `[codex]` or similar source markers.
""",
    "git-pull-request-merge-method": "squash",
}


def read_document() -> tomlkit.TOMLDocument:
    if not CONFIG_PATH.exists():
        return tomlkit.document()
    return tomlkit.parse(CONFIG_PATH.read_text(encoding="utf-8"))


def ensure_table(container: TomlContainer, key: str) -> Table:
    value = container.get(key)
    if value is None:
        value = tomlkit.table()
        container[key] = value
    if not isinstance(value, Table):
        raise SystemExit(f"{key} must be a TOML table")
    return value


def apply_patch(old: TomlContainer, patch: Patch) -> None:
    for key, value in patch.items():
        current = old.get(key)
        if value is None:
            old.pop(key, None)
        elif current != value:
            old.pop(key, None)
            old[key] = value


def main() -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)

    before = CONFIG_PATH.read_text(encoding="utf-8") if CONFIG_PATH.exists() else ""
    document = read_document()
    apply_patch(document, TOP_LEVEL_PATCH)
    apply_patch(ensure_table(document, "desktop"), DESKTOP_PATCH)

    after = tomlkit.dumps(document)
    if after != before:
        CONFIG_PATH.write_text(after, encoding="utf-8")


if __name__ == "__main__":
    main()
