#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "tomlkit==0.13.3",
# ]
# ///
"""Replace managed top-level values while preserving unmanaged top-level keys."""

from pathlib import Path

import tomlkit

CONFIG_PATH = Path.home() / ".codex" / "config.toml"

Patch = dict[str, object | None]

# Nested mappings are authoritative snapshots; complete replacement prevents local config drift.
TOP_LEVEL_PATCH: Patch = {
    "model": "gpt-5.6-sol",
    "model_reasoning_effort": "high",
    "approval_policy": "on-request",
    "approvals_reviewer": "guardian_subagent",
    "features": {
        "js_repl": True,
        "memories": True,
        "multi_agent_v2": {
            "enabled": True,
            "multi_agent_mode_hint_text": """\
Use sub-agents selectively when a configured role matches a bounded task and delegation would materially improve isolated context, independent judgment, parallel execution, or execution quality. Handle trivial lookups, routine commands, and small validations directly.

Before spawning a sub-agent, define the single question or objective it owns; the unique value expected from delegation; fixed decisions it must not reopen; explicit non-goals; supplied evidence and stopping criteria; the maximum output shape; and what the root will do in parallel. Choose the narrowest fitting role and pass only the context it needs. Do not delegate routine inspection, deterministic validation, small edits, or work the root has already completed.

The root agent owns decomposition, coordination, scope changes, result integration, and verification. Use at most one independent reviewer per artifact or claim. After fixes, the root performs deterministic verification; do not start a review chain. Sub-agents must not spawn child agents unless the root explicitly authorizes nested delegation in the handoff.

For discovery and review work, require the sub-agent to separate novel findings, confirmations, and unknowns. If it has no novel finding, it should say so directly rather than restating supplied context.
""",
        },
    },
    "desktop": {
        "followUpQueueMode": "queue",
        "reviewDelivery": "detached",
        "preventSleepWhileRunning": True,
        "git-commit-instructions": """\
Choose commit messages style in this order:

1. Follow repository-local commit message instructions when present, such as AGENTS.md, CLAUDE.md, CONTRIBUTING.md, or an explicit user instruction.
2. If the repository has no explicit instructions, inspect the recent commit history and match its established style.
3. If neither local instructions nor recent history establish a style, use Conventional Commits.

Keep the subject concise, imperative. Add a body when it clarifies non-obvious context.
""",
        "git-pr-instructions": """\
Write PR titles as final-quality commit titles, no `[codex]` or similar source markers.
""",
        "git-pull-request-merge-method": "squash",
    },
    "sandbox_mode": "workspace-write",
    "sandbox_workspace_write": {
        "network_access": True,
    },
}


def read_document() -> tomlkit.TOMLDocument:
    if not CONFIG_PATH.exists():
        return tomlkit.document()
    return tomlkit.parse(CONFIG_PATH.read_text(encoding="utf-8"))


def apply_patch(old: tomlkit.TOMLDocument, patch: Patch) -> None:
    for key, value in patch.items():
        current = old.get(key)
        if value is None:
            old.pop(key, None)
        elif current != value:
            old.pop(key, None)
            old[key] = value


def main() -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)

    before = CONFIG_PATH.read_text(encoding="utf-8") if CONFIG_PATH.exists() else ""
    document = read_document()
    apply_patch(document, TOP_LEVEL_PATCH)

    after = tomlkit.dumps(document)
    if after != before:
        CONFIG_PATH.write_text(after, encoding="utf-8")


if __name__ == "__main__":
    main()
