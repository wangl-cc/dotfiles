{{- /* Render a regular file so Podman's :Z relabels the mounted content, not a symlink. */ -}}
{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "enable_logging": true,
    "disable_content_logging": true,
    "log_retention_days": 30,
    "enforce_auth_on_inference": true
  },
  "governance": {
    "auth_config": {
      "is_enabled": false
    }
  },
  "plugins": [
    {
      "name": "otel",
      "enabled": false,
      "config": {
        "enabled": false
      }
    }
  ],
  "providers": {
    "vllm": {
      "keys": [
        {
          "name": "local-mt",
          "value": "",
          "models": ["hy-mt2-7b"],
          "weight": 1,
          "vllm_key_config": {
            "url": "http://vllm:8000",
            "model_name": "hy-mt2-7b"
          }
        }
      ],
      "network_config": {
        "allow_private_network": true,
        "keep_alive_timeout_in_seconds": 3
      }
    }
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/config.db"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/logs.db"
    },
    "retention_days": 30
  }
}
