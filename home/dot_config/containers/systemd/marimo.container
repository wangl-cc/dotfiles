[Unit]
Description=Shared marimo notebook server

[Container]
# Process
Image=box-base.build
ContainerName=marimo
WorkingDir=/home/%u/Documents
Exec=marimo edit /home/%u/Documents --sandbox --headless --host 0.0.0.0 --port 2718 --no-token --skip-update-check

# Shared development tool paths and application configuration directories.
EnvironmentFile=./development.env

# Reap orphaned processes from notebook kernels and package tools.
RunInit=true

# Network: browser and agent access through workspace; no credential network membership.
Network=workspace.network

# Identity: retain host ownership when reading and writing the shared home.
UserNS=keep-id

# SELinux: preserve existing labels on the shared home; avoid recursive relabeling.
SecurityLabelDisable=true

# Shared home: reuse projects, tools and configuration; mask private host state.
Volume=%h:/home/%u
Mask=/home/%u/.ssh:/home/%u/.local/share/containers:/home/%u/.local/share/zed/server_state:/home/%u/.config/credstore.encrypted

# Runtime files: use host timezone data and disposable scratch space.
Volume=/etc/localtime:/etc/localtime:ro
Tmpfs=/tmp

# Kernel IPC: provide private shared memory for notebook processes.
ShmSize=256m

[Service]
# Install on the host into shared home; managed Python is also available in the container.
# Reuse an existing installation; upgrades are explicit via uv tool upgrade marimo.
ExecStartPre=%h/.local/bin/uv tool install --managed-python marimo[sandbox]
Restart=on-failure
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=default.target
