[Unit]
Description=Development and agent Pod

[Pod]
PodName=workspace
Network=pasta
UserNS=keep-id
HostName=%H
# Do not share PID or IPC; dev-box retains its own host IPC setting.
PodmanArgs=--share=net,uts --security-opt=label=disable
ExitPolicy=continue
PublishPort=127.0.0.1:2222:2222
PublishPort=127.0.0.1:443:8443
{{ with get .device "tailscale_ipv4" -}}
PublishPort={{ . }}:2222:2222
PublishPort={{ . }}:443:8443

[Service]
ExecStartPre=/usr/bin/tailscale wait --timeout=90s
ExecStartPre=/usr/bin/tailscale ip --assert={{ . }}
RestartSec=5
{{ end }}
[Install]
WantedBy=default.target
