[Build]
ImageTag=localhost/fedora-codex-box

Pull=newer

# Share the multi-stage Containerfile and cached Fedora layers with dev-box.
SetWorkingDirectory=%h/.local/share/chezmoi/dev-box
Target=codex-box
BuildArg=USERNAME=%u
BuildArg=USER_UID=%U
BuildArg=USER_GID=%G
{{ $codex := index .container_pkgs.packages "codex" }}
BuildArg=CODEX_REPO={{ $codex.repo }}
BuildArg=CODEX_VERSION={{ trimPrefix "rust-v" $codex.tag }}
{{ $target := index $codex.targets "linux-x86_64" }}
BuildArg=CODEX_ASSET={{ $target.asset }}
BuildArg=CODEX_SHA256={{ $target.sha256 }}

[Service]
TimeoutStartSec=900
