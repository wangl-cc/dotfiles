[Unit]
Description=Codex Remote Control Container
Requires=ssh-agent.socket
Wants=ssh-agent-load.service
After=ssh-agent-load.service

[Container]
Image=box-base.build
ContainerName=my-codex-box
RunInit=true
User=%u
WorkingDir=/home/%u
Exec=/home/%u/.local/bin/codex app-server --remote-control --listen unix://

Network=host
UserNS=keep-id
HostName=%H
SecurityLabelDisable=true
Volume=/etc/localtime:/etc/localtime:ro
Tmpfs=/tmp

Volume=%t/ssh-agent.socket:/run/ssh-agent.socket
Environment=SSH_AUTH_SOCK=/run/ssh-agent.socket

# Codex shares the host user's projects, tools, configuration, and runtime
# state. Its system environment and process lifecycle remain containerized.
Volume=%h:/home/%u

# Do not expose host container storage or editor runtime sockets through the
# recursive home bind.
Mask=/home/%u/.local/share/containers:/home/%u/.local/share/zed/server_state

# Keep private key files outside the container. Git and SSH authenticate via
# the host agent; this volume only holds client configuration and known hosts.
Volume=codex-box-ssh:/home/%u/.ssh:U

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
