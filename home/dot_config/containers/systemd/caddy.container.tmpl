[Unit]
Description=Private HTTPS entry point for workspace services

[Container]
# Process: use the custom image's non-root user and default Caddy command.
Image=caddy.build
ContainerName=caddy
# Map the credential owner to the image user without changing credential permissions.
UserNS=keep-id:uid=65532,gid=65532

# Network: reach development services; the drop-in publishes Tailscale HTTPS.
Network=workspace.network

# Caddy reads the token directly through its file placeholder.
Volume=%d:/run/credentials:ro,Z
Volume=%h/.config/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,Z

# Persistent state: preserve certificates and ACME accounts.
# U assigns volume ownership to the image user; Z provides private SELinux labels.
Volume=caddy-data:/data:U,Z
Volume=caddy-config:/config:U,Z

# Scratch: temporary files do not belong in persistent service state.
Tmpfs=/tmp

[Service]
LoadCredentialEncrypted=cloudflare-dns-token
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
