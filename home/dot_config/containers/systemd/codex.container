[Unit]
Description=Codex Remote Control Container
Requires=ssh-agent.socket
Wants=ssh-agent-load.service
After=ssh-agent-load.service

[Container]
Image=box-base.build
ContainerName=codex
RunInit=true
User=%u
WorkingDir=/home/%u
Exec=/home/%u/.local/bin/codex app-server --remote-control --listen unix://

Pod=workspace.pod
SecurityLabelDisable=true
# Allow profiling syscalls such as perf_event_open.
SeccompProfile=unconfined
# Nested bwrap needs a fully visible outer /proc to mount its own procfs.
# Podman's /proc masks and read-only submounts otherwise cause EPERM.
Unmask=/proc/*
Volume=/etc/localtime:/etc/localtime:ro
Tmpfs=/tmp
# Share the protected Codex socket directory with the SSH entry container.
Volume=%t/codex-sockets:/tmp/codex-daemon-%U

Volume=%t/ssh-agent.socket:/run/ssh-agent.socket
Environment=SSH_AUTH_SOCK=/run/ssh-agent.socket

# Codex shares the host user's projects, tools, configuration, and runtime
# state. Its system environment and process lifecycle remain containerized.
Volume=%h:/home/%u
Volume=%h/.config/secret-proxy/gitconfig:/etc/gitconfig:ro

# Do not expose host container storage or editor runtime sockets through the
# recursive home bind.
Mask=/home/%u/.local/share/containers:/home/%u/.local/share/zed/server_state:/home/%u/.config/secret-proxy/credentials

# Keep private key files outside the container. Git and SSH authenticate via
# the host agent; this volume only holds client configuration and known hosts.
Volume=codex-box-ssh:/home/%u/.ssh:U

[Service]
RuntimeDirectory=codex-sockets
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
