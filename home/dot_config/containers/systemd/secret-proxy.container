[Unit]
Description=Private HTTP credential proxy
# Provision credentials on the host before starting this optional Pod member.
ConditionPathExists=%h/.config/secret-proxy/credentials/overleaf-token.cred

[Container]
Image=secret-proxy.build
ContainerName=secret-proxy
Pod=workspace.pod
RunInit=true
User=%U
Group=%G
SecurityLabelDisable=true
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Volume=%h/.config/secret-proxy/config.json:/etc/secret-proxy/config.json:ro
Volume=%d:/run/credentials:ro
Exec=-config /etc/secret-proxy/config.json -credentials-dir /run/credentials

[Service]
LoadCredentialEncrypted=overleaf-token:%h/.config/secret-proxy/credentials/overleaf-token.cred
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
