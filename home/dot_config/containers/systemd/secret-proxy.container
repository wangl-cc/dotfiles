[Unit]
Description=Private HTTP credential proxy
# Provision credentials on the host before starting this optional service.
ConditionPathExists=%h/.config/credstore.encrypted/overleaf-token
ConditionPathExists=%h/.config/credstore.encrypted/github-token

[Container]
# Process: the image entrypoint runs the credential proxy directly.
Image=secret-proxy.build
ContainerName=secret-proxy
Exec=-config /etc/secret-proxy/config.json -credentials-dir /run/credentials

# Network: only trusted development clients join the secret-proxy network.
Network=secret-proxy.network

# Confinement: no writable image state or additional process privileges are needed.
ReadOnly=true
NoNewPrivileges=true
DropCapability=all

# Configuration and credentials: both mounts are read-only; Z requests private labels.
# The credential directory is supplied by LoadCredentialEncrypted below.
Volume=%h/.config/secret-proxy/config.json:/etc/secret-proxy/config.json:ro,Z
Volume=%d:/run/credentials:ro,Z

# Proxy clients share only the socket directory, never the credentials.
Volume=%t/secret-proxy:/run/secret-proxy:Z

[Service]
# Decrypt only for this service; the container receives the directory through %d.
LoadCredentialEncrypted=overleaf-token
LoadCredentialEncrypted=github-token

# Keep the directory inode stable for clients that remain running on restart.
RuntimeDirectory=secret-proxy
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
