[Unit]
Description=Public folder over SMB on Tailscale

[Container]
# Process
Image=smb-box.build
ContainerName=smb-box

# Reap orphaned processes from Samba client sessions.
RunInit=true

# Network: independent rootless networking; the drop-in publishes the Tailscale port.
Network=private
HostName=%H

# Identity: map the host user to smb; namespace root can switch to that account.
UserNS=keep-id:uid=1000,gid=1000
User=0

# SELinux: preserve existing labels on the shared host Documents directory.
SecurityLabelDisable=true

# Shared files: expose host Documents with their existing ownership.
Volume=%h/Documents:/srv/public/Documents:rw

# Persistent state: retain Samba accounts and service databases.
Volume=smb-box-data:/var/lib/samba

# Runtime files: use host timezone data and disposable scratch space.
Volume=/etc/localtime:/etc/localtime:ro
Tmpfs=/tmp
Tmpfs=/run/samba

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
